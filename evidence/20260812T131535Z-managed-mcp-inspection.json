            "create_statement": "CREATE TABLE public.memories (\n\tid UUID NOT NULL DEFAULT gen_random_uuid(),\n\ttenant_id STRING NOT NULL,\n\tproject_id STRING NOT NULL,\n\trepository_id STRING NOT NULL,\n\tswarm_id STRING NOT NULL,\n\trun_id STRING NOT NULL,\n\ttask_id UUID NULL,\n\tagent_id STRING NOT NULL,\n\tkind STRING NOT NULL,\n\tstate STRING NOT NULL DEFAULT 'tentative':::STRING,\n\tvisibility STRING NOT NULL DEFAULT 'run':::STRING,\n\tcontent STRING NOT NULL,\n\tcontent_json JSONB NULL,\n\ttitle STRING NULL,\n\ttags STRING[] NOT NULL DEFAULT ARRAY[]:::STRING[],\n\tnormalized_sha256 BYTES NOT NULL,\n\tdedup_scope STRING NOT NULL,\n\tconfidence DECIMAL(5,4) NOT NULL DEFAULT 0.5000:::DECIMAL,\n\toccurred_at TIMESTAMPTZ NULL,\n\tvalid_from TIMESTAMPTZ NOT NULL DEFAULT now():::TIMESTAMPTZ,\n\tvalid_to TIMESTAMPTZ NULL,\n\trecorded_from TIMESTAMPTZ NOT NULL DEFAULT now():::TIMESTAMPTZ,\n\trecorded_to TIMESTAMPTZ NULL,\n\tsupersedes_id UUID NULL,\n\tsuperseded_by_id UUID NULL,\n\tsource_id UUID NULL,\n\tprevious_state STRING NULL,\n\tpolicy_reason STRING NOT NULL DEFAULT '':::STRING,\n\tpolicy_confidence DECIMAL(5,4) NOT NULL DEFAULT 1.0000:::DECIMAL,\n\tversion INT8 NOT NULL DEFAULT 1:::INT8,\n\tmetadata JSONB NOT NULL DEFAULT '{}':::JSONB,\n\tCONSTRAINT memories_pkey PRIMARY KEY (id ASC),\n\tCONSTRAINT memories_task_id_fkey FOREIGN KEY (task_id) REFERENCES public.tasks(id) ON DELETE SET NULL,\n\tCONSTRAINT memories_supersedes_id_fkey FOREIGN KEY (supersedes_id) REFERENCES public.memories(id) ON DELETE RESTRICT,\n\tCONSTRAINT memories_superseded_by_id_fkey FOREIGN KEY (superseded_by_id) REFERENCES public.memories(id) ON DELETE RESTRICT,\n\tCONSTRAINT memories_source_id_fkey FOREIGN KEY (source_id) REFERENCES public.sources(id) ON DELETE SET NULL,\n\tINDEX memories_current_scope (tenant_id ASC, repository_id ASC, run_id ASC, visibility ASC, state ASC, recorded_from DESC, id ASC) STORING (task_id, agent_id, kind, confidence, valid_from, valid_to, content) WHERE recorded_to IS NULL,\n\tINDEX memories_task_current (task_id ASC, state ASC, recorded_from DESC, id ASC) STORING (kind, confidence, content, agent_id) WHERE (task_id IS NOT NULL) AND (recorded_to IS NULL),\n\tINDEX memories_source (source_id ASC) STORING (state, recorded_to, supersedes_id, superseded_by_id) WHERE source_id IS NOT NULL,\n\tUNIQUE INDEX memories_one_successor (supersedes_id ASC) WHERE supersedes_id IS NOT NULL,\n\tINDEX memories_current_fingerprint (tenant_id ASC, repository_id ASC, dedup_scope ASC, kind ASC, normalized_sha256 ASC) WHERE (recorded_to IS NULL) AND (state != 'refuted':::STRING),\n\tCONSTRAINT memories_state_check CHECK (state IN ('tentative':::STRING, 'confirmed':::STRING, 'refuted':::STRING, 'superseded':::STRING)),\n\tCONSTRAINT memories_visibility_check CHECK (visibility IN ('task':::STRING, 'run':::STRING, 'repository':::STRING)),\n\tCONSTRAINT memories_task_visibility_check CHECK ((visibility != 'task':::STRING) OR (task_id IS NOT NULL)),\n\tCONSTRAINT memories_confidence_check CHECK ((confidence >= 0:::DECIMAL) AND (confidence <= 1:::DECIMAL)),\n\tCONSTRAINT memories_policy_confidence_check CHECK ((policy_confidence >= 0:::DECIMAL) AND (policy_confidence <= 1:::DECIMAL)),\n\tCONSTRAINT memories_previous_state_check CHECK ((previous_state IS NULL) OR (previous_state IN ('tentative':::STRING, 'confirmed':::STRING, 'refuted':::STRING))),\n\tCONSTRAINT memories_valid_interval_check CHECK ((valid_to IS NULL) OR (valid_to > valid_from)),\n\tCONSTRAINT memories_recorded_interval_check CHECK ((recorded_to IS NULL) OR (recorded_to > recorded_from)),\n\tCONSTRAINT memories_supersession_check CHECK ((supersedes_id IS NULL) OR (supersedes_id != id))\n) WITH (schema_locked = true) LOCALITY REGIONAL BY TABLE IN PRIMARY REGION;",
