{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSwarmBrainSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "<DATABASE_URL_SECRET_ARN>",
        "<TOKEN_SECRET_ARN>"
      ]
    },
    {
      "Sid": "CreateOwnLogGroups",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": [
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/ecs/swarm-brain/api:*",
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/ecs/swarm-brain/worker:*"
      ]
    }
  ]
}
