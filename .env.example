# Copy to .env and edit. NOTHING AUTO-LOADS THIS FILE — not the API, not the
# worker, not any script in scripts/. The load convention is explicit:
#
#     set -a; source .env; set +a
#
# `set -a` marks every subsequent assignment for export, so the variables reach
# child processes; `set +a` turns that back off. Without it, `source .env` sets
# shell variables that no subprocess can see, which looks identical to a typo.
#
# .env is gitignored. .env.example is not, and must never hold a real value.

# Backend selection is mandatory. Use exactly "memory" or "cockroach".
SWARMBRAIN_BACKEND=memory
SWARMBRAIN_TOKEN_SECRET=replace-with-at-least-16-random-bytes

# Required only when SWARMBRAIN_BACKEND=cockroach. A URL is rejected for memory.
# SWARMBRAIN_DATABASE_URL=postgresql://root@127.0.0.1:26257/swarmbrain?sslmode=disable
SWARMBRAIN_DATABASE_POOL_MIN_SIZE=1
SWARMBRAIN_DATABASE_POOL_MAX_SIZE=12

# Operator-owned ingestion policy. These fields are never accepted from HTTP/MCP.
SWARMBRAIN_INGEST_TRUST=unknown
SWARMBRAIN_INGEST_USE_PROVIDER=false
SWARMBRAIN_INGEST_CHUNK_CHARS=65536
SWARMBRAIN_INGEST_PRIORITY=0

# Optional typed-memory compiler. Setting INGEST_USE_PROVIDER=true without a
# complete provider profile fails startup; transient/model failures still fall
# back to deterministic extraction while preserving the raw source.
SWARMBRAIN_EXTRACTION_PROVIDER=none
# SWARMBRAIN_EXTRACTION_MODEL=Qwen/Qwen3-32B-Instruct
# SWARMBRAIN_EXTRACTION_REVISION=deployment-2026-08-09
# SWARMBRAIN_EXTRACTION_BASE_URL=http://chat.local:8000
# SWARMBRAIN_EXTRACTION_API_KEY=
SWARMBRAIN_EXTRACTION_TIMEOUT_SECONDS=20
SWARMBRAIN_EXTRACTION_MAX_OUTPUT_TOKENS=4096

# Optional evidence-gated Observer/Reflector consolidation. The observer only
# snapshots current confirmed memories with accepted evidence. The worker
# stages the exact plan before applying tentative derived memories through the
# normal memory policy. Provider mode reuses the extraction endpoint/model
# profile above but uses a separate strict prompt/schema; failure is a no-op.
SWARMBRAIN_CONSOLIDATION_ENABLED=false
SWARMBRAIN_CONSOLIDATION_USE_PROVIDER=false
SWARMBRAIN_CONSOLIDATION_MAX_MEMORIES=12
SWARMBRAIN_CONSOLIDATION_MAX_ACTIONS=4
SWARMBRAIN_CONSOLIDATION_MAX_INPUT_BYTES=65536

# Optional dense recall. CockroachDB requires exactly 1024 dimensions.
SWARMBRAIN_EMBEDDINGS=none
# SWARMBRAIN_EMBEDDINGS_MODEL=deterministic-v0
SWARMBRAIN_EMBEDDINGS_DIMENSIONS=1024
# SWARMBRAIN_AWS_REGION=eu-central-1
# Optional raw cosine floor; 0.0 preserves compatibility until a model/corpus
# benchmark justifies pruning. CockroachDB evaluates this many ANN partitions
# per tree; tune either value only against the exact oracle and judged runs.
SWARMBRAIN_RETRIEVAL_DENSE_MIN_SIMILARITY=0.0
SWARMBRAIN_RETRIEVAL_DENSE_ANN_BEAM_SIZE=32

# Separate durable worker process. Limit remains 1 until lease heartbeats exist.
# SWARMBRAIN_WORKER_ID=local-worker-1
SWARMBRAIN_WORKER_POLL_INTERVAL_SECONDS=0.5
SWARMBRAIN_WORKER_LEASE_SECONDS=60
SWARMBRAIN_WORKER_RETRY_DELAY_SECONDS=30
SWARMBRAIN_WORKER_LIMIT=1

SWARMBRAIN_HOST=127.0.0.1
SWARMBRAIN_PORT=8080

# stdio MCP bridge. Never commit an issued agent token.
SWARMBRAIN_API_URL=http://127.0.0.1:8080
# SWARMBRAIN_AGENT_TOKEN=
# SWARMBRAIN_RUN_ID=55555555-5555-5555-5555-555555555555
# SWARMBRAIN_AGENT_ID=66666666-6666-6666-6666-666666666666
SWARMBRAIN_REQUEST_TIMEOUT_SECONDS=20


# ===========================================================================
# ACTIVATION KEYS — the operator provides these; everything above works
# without them
# ===========================================================================
#
# Every setting in this block is inert until a real value is supplied. The
# repository is deliberately runnable with none of them: the memory backend,
# the local CockroachDB backend, the console and the test suite all work with
# the defaults above. What this block turns on is the AWS half — Bedrock
# embeddings — and the hosted-demo behaviour.
#
# NOTHING HERE MAY EVER HOLD A REAL VALUE IN .env.example. Put real values in
# .env, which is gitignored, and load them with:
#
#     set -a; source .env; set +a
#
# Order of operations once the keys land is in docs/deploy.md. The short
# version: source .env, then run `python3 scripts/bedrock_smoke.py` BEFORE
# anything is deployed. It is a two-second check that fails cheaply.

# --- AWS credentials -------------------------------------------------------
#
# These are for an OPERATOR'S LAPTOP only — running scripts/bedrock_smoke.py,
# or the aws CLI steps in deploy/README.md. They are NEVER part of the
# deployment: an ECS task gets its credentials from the task role through the
# container credentials endpoint, and boto3 discovers them by itself. If a
# static key ever appears in a task definition or an image, something is wrong.
#
# Supply EITHER the static pair:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary/STS credentials
#
# OR a named profile from ~/.aws/credentials — preferable, because it keeps the
# secret out of the process environment entirely:
# AWS_PROFILE=

# Region for Bedrock and for the deployment. us-east-1 is the target: it is the
# cheapest region for Fargate, it carries Titan V2 as a plain in-region model
# (no inference profile, which would change the IAM ARNs), and it is where the
# CockroachDB Cloud Basic cluster goes.
# AWS_REGION=us-east-1

# --- Bedrock embeddings ----------------------------------------------------
#
# Switches dense recall from "none" (the default above) to the real provider.
# The model ID is not a free choice: the dense projection stamps every stored
# vector with the model that produced it, so changing it invalidates existing
# vectors — a reindex, not a config change. It must also match the model ARN in
# deploy/iam/task-role-policy.json.
#
# SWARMBRAIN_EMBEDDINGS_DIMENSIONS must stay 1024: config rejects anything else
# when the backend is cockroach, because it must match the VECTOR(1024) column
# and its ANN index.
# SWARMBRAIN_EMBEDDINGS=bedrock
# SWARMBRAIN_EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
# SWARMBRAIN_AWS_REGION=us-east-1

# --- Self-hosted embeddings (OpenAI-compatible endpoint) --------------------
#
# "openai" points the same dense pipeline at any /v1/embeddings-compatible
# server (vLLM, TEI). The base URL is required; the API key is optional and
# only sent when set. The same model-ID reindex warning above applies.
#
# SWARMBRAIN_EMBEDDINGS=openai
# SWARMBRAIN_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
# SWARMBRAIN_EMBEDDINGS_BASE_URL=http://embed.local:8100
# SWARMBRAIN_EMBEDDINGS_API_KEY=

# --- Hosted demo -----------------------------------------------------------
#
# The console demo trigger: `enabled` lets a judge drive the scripted swarm
# from the page instead of a shell, which is the difference between a demo URL
# and a screenshot. Leave it unset for a plain read-only console — it is the
# one control on the page that causes writes.
#
# The trigger is on only when this case-folds to exactly "enabled". Any other
# value — including "true", "1" and "yes" — leaves it off. Fail-closed on
# purpose, and the opposite of how the other booleans above parse.
# SWARMBRAIN_CONSOLE_DEMO=enabled
#
# Same exact-word gate for the anonymous OpenAPI surface (/docs, /redoc,
# /openapi.json); the interactive pages also load third-party CDN assets.
# SWARMBRAIN_PUBLIC_DOCS=enabled
