# Backend selection is mandatory. Use exactly "memory" or "cockroach".
SWARMBRAIN_BACKEND=memory
SWARMBRAIN_TOKEN_SECRET=replace-with-at-least-16-random-bytes

# Required only when SWARMBRAIN_BACKEND=cockroach. A URL is rejected for memory.
# SWARMBRAIN_DATABASE_URL=postgresql://root@127.0.0.1:26257/swarmbrain?sslmode=disable
SWARMBRAIN_DATABASE_POOL_MIN_SIZE=1
SWARMBRAIN_DATABASE_POOL_MAX_SIZE=12

SWARMBRAIN_HOST=127.0.0.1
SWARMBRAIN_PORT=8080

# Semantic memory. "none" disables the vector plane entirely; "deterministic"
# runs the full durable pipeline without credentials; "bedrock" needs the
# swarmbrain[aws] extra plus AWS credentials in the environment.
SWARMBRAIN_EMBEDDINGS=none
# SWARMBRAIN_EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
SWARMBRAIN_EMBEDDINGS_DIMENSIONS=1024
# SWARMBRAIN_AWS_REGION=us-east-1
# Optional identity for the swarmbrain-worker process.
# SWARMBRAIN_WORKER_ID=embed-worker-1
SWARMBRAIN_WORKER_POLL_SECONDS=2

# stdio MCP bridge. Never commit an issued agent token.
SWARMBRAIN_API_URL=http://127.0.0.1:8080
# SWARMBRAIN_AGENT_TOKEN=
# SWARMBRAIN_RUN_ID=55555555-5555-5555-5555-555555555555
# SWARMBRAIN_AGENT_ID=66666666-6666-6666-6666-666666666666
SWARMBRAIN_REQUEST_TIMEOUT_SECONDS=20
