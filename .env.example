# Backend selection is mandatory. Use exactly "memory" or "cockroach".
SWARMBRAIN_BACKEND=memory
SWARMBRAIN_TOKEN_SECRET=replace-with-at-least-16-random-bytes

# Required only when SWARMBRAIN_BACKEND=cockroach. A URL is rejected for memory.
# SWARMBRAIN_DATABASE_URL=postgresql://root@127.0.0.1:26257/swarmbrain?sslmode=disable
SWARMBRAIN_DATABASE_POOL_MIN_SIZE=1
SWARMBRAIN_DATABASE_POOL_MAX_SIZE=12

# Operator-owned ingestion policy. These fields are never accepted from HTTP/MCP.
SWARMBRAIN_INGEST_TRUST=unknown
SWARMBRAIN_INGEST_USE_PROVIDER=false
SWARMBRAIN_INGEST_CHUNK_CHARS=65536
SWARMBRAIN_INGEST_PRIORITY=0

# Optional dense recall. CockroachDB requires exactly 1024 dimensions.
SWARMBRAIN_EMBEDDINGS=none
# SWARMBRAIN_EMBEDDINGS_MODEL=deterministic-v0
SWARMBRAIN_EMBEDDINGS_DIMENSIONS=1024
# SWARMBRAIN_AWS_REGION=eu-central-1
# Optional raw cosine floor; 0.0 preserves compatibility until a model/corpus
# benchmark justifies pruning. CockroachDB evaluates this many ANN partitions
# per tree; tune either value only against the exact oracle and judged runs.
SWARMBRAIN_RETRIEVAL_DENSE_MIN_SIMILARITY=0.0
SWARMBRAIN_RETRIEVAL_DENSE_ANN_BEAM_SIZE=32

# Separate durable worker process. Limit remains 1 until lease heartbeats exist.
# SWARMBRAIN_WORKER_ID=local-worker-1
SWARMBRAIN_WORKER_POLL_INTERVAL_SECONDS=0.5
SWARMBRAIN_WORKER_LEASE_SECONDS=60
SWARMBRAIN_WORKER_RETRY_DELAY_SECONDS=30
SWARMBRAIN_WORKER_LIMIT=1

SWARMBRAIN_HOST=127.0.0.1
SWARMBRAIN_PORT=8080

# stdio MCP bridge. Never commit an issued agent token.
SWARMBRAIN_API_URL=http://127.0.0.1:8080
# SWARMBRAIN_AGENT_TOKEN=
# SWARMBRAIN_RUN_ID=55555555-5555-5555-5555-555555555555
# SWARMBRAIN_AGENT_ID=66666666-6666-6666-6666-666666666666
SWARMBRAIN_REQUEST_TIMEOUT_SECONDS=20
